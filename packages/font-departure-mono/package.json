{
  "name": "@proj-airi/font-departure-mono",
  "type": "module",
  "version": "0.17.0",
  "description": "Essential CSS for font, Departure Mono, used by Project AIRI",
  "author": {
    "name": "Tobias Fried",
    "url": "https://github.com/rektdeckard/departure-mono"
  },
  "license": "SIL Open Font License",
  "homepage": "https://departuremono.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/proj-airi/fonts.git",
    "directory": "packages/font-departure-mono"
  },
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./files/*.otf": {
      "default": "./dist/files/*.otf"
    },
    "./files/*.woff": {
      "default": "./dist/files/*.woff"
    },
    "./files/*.woff2": {
      "default": "./dist/files/*.woff2"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown"
  }
}

{
  "name": "@proj-airi/font-xiaolai",
  "type": "module",
  "version": "0.17.0",
  "description": "Essential CSS for font, Xiaolai (小赖字体 / 小賴字體 / シャオライ / Xiaolai Font), used by Project AIRI",
  "author": {
    "name": "ʟxɢᴡ",
    "url": "https://github.com/lxgw"
  },
  "license": "SIL Open Font License",
  "homepage": "https://github.com/lxgw/kose-font",
  "repository": {
    "type": "git",
    "url": "https://github.com/proj-airi/fonts.git",
    "directory": "packages/font-xiaolai"
  },
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown"
  }
}
